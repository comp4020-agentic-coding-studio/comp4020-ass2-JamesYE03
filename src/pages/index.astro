---
import Card from "astro-theme-university/components/Card.astro";
import CardGrid from "astro-theme-university/components/CardGrid.astro";
import ContentLayout from "astro-theme-university/layouts/ContentLayout.astro";
import ScheduleTable from "../components/ScheduleTable.astro";
import heroImage from "../assets/images/hero-home.avif";
import { courseMeta } from "../course-config";
import { sessionLabels, siteConfig } from "../site-config";
---

<ContentLayout
  title={`${courseMeta.code}: ${courseMeta.title}`}
  description={courseMeta.description}
  heroImage={heroImage}
  heroImageAlt="A magnifying glass held over a grid of flat pixels, three of them picked out in gold, in flat black and gold shapes on warm cream"
  {...siteConfig}
>
  <ul class="course-tags" aria-label="Course tags">
    {courseMeta.tags.map((tag) => <li>{tag}</li>)}
  </ul>

  <h2>The twelve weeks</h2>
  <p>
    Every lecture, every casework session, and every assignment deadline, in
    the order they actually happen. Each cell links to the real page.
  </p>
  <ScheduleTable />

  <h2>What you will do</h2>
  <p>
    Every week you're handed a case: a passage, an image, a clip, a workplace
    document, a live dispute — and a growing toolkit for working it properly.
    You'll run textual and image forensics, embed and break watermarks, read a
    provenance standard instead of guessing, argue both sides of a real
    dispute before reaching a verdict, and finish the semester with an
    independent investigation you chose yourself. You walk out with a
    portfolio of worked cases and a habit of asking what would actually change
    your mind.
  </p>

  <h2>Who it is for</h2>
  <p>
    Graduate students who already write and read critically and want a
    concrete, evidence-based practice for the specific problem generative AI
    creates — not a general media-literacy refresher. You don't need a
    machine-learning background; you do need patience for a method that
    admits what it can't yet prove.
  </p>

  <h2>Where to go next</h2>
  <CardGrid columns={2}>
    <Card title={sessionLabels.plural} href="/sessions/">
      <p>The weekly schedule and what happens in each teaching session.</p>
    </Card>
    <Card title="Assessment" href="/assessments/">
      <p>What is marked, what it is worth, and when it is due.</p>
    </Card>
    <Card title="People" href="/people/">
      <p>Who teaches the course and how to reach them.</p>
    </Card>
    <Card title="Spot the Slop" href="/spot-the-slop/">
      <p>A short practice round for week 3's textual tells, open to anyone.</p>
    </Card>
  </CardGrid>
</ContentLayout>

<style>
  .course-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-block: 0 2rem;
    padding: 0;
    list-style: none;
  }

  .course-tags li {
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    color: var(--at-text-secondary);
    background: var(--at-bg-alt);
    font-size: 0.9rem;
  }
</style>
