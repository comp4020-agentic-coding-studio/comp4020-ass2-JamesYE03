---
import { render } from "astro:content";
import { getPublishedCollection } from "astro-course-university/content";
import RelatedContent from "astro-course-university/components/RelatedContent.astro";
import Callout from "astro-theme-university/components/Callout.astro";
import Icon from "astro-theme-university/components/Icon.astro";
import ContentLayout from "astro-theme-university/layouts/ContentLayout.astro";
import { withBase } from "astro-theme-university/url";
import TeachingTeam from "../../components/TeachingTeam.astro";
import { formatCourseDate } from "../../lib/dates";
import { graphCollections, sessionLabels, siteConfig } from "../../site-config";

export async function getStaticPaths() {
  const lectures = await getPublishedCollection("lectures");
  return lectures.map((lecture) => ({ params: { slug: lecture.id }, props: { lecture } }));
}

const { lecture } = Astro.props;
const { Content } = await render(lecture);
const title = `Lecture ${String(lecture.data.week).padStart(2, "0")} — ${lecture.data.title}`;

const sessions = await getPublishedCollection("sessions");
const thisWeeksCase = sessions.find((session) => session.data.week === lecture.data.week);
---

<ContentLayout title={title} description={lecture.data.description} {...siteConfig}>
  <p><strong>{formatCourseDate(lecture.data.date)}</strong></p>
  {
    lecture.data.slides && (
      <div class="slides-link">
        <p class="slides-link-label">Slides</p>
        <a href={withBase(lecture.data.slides)} class="slides-link-button">
          <Icon name="presentation" size="1.3em" />
          Open the Lecture {String(lecture.data.week).padStart(2, "0")} deck
        </a>
      </div>
    )
  }
  {
    thisWeeksCase && (
      <Callout type="tip">
        <p>
          This lecture is read before{" "}
          <strong>
            Case {String(thisWeeksCase.data.week).padStart(2, "0")}
          </strong>
          , the same week's {sessionLabels.singular.toLowerCase()}:{" "}
          <a href={withBase(`/sessions/${thisWeeksCase.id}/`)}>{thisWeeksCase.data.title}</a>.
        </p>
      </Callout>
    )
  }
  <Content />
  <TeachingTeam teachers={lecture.data.teachers} />
  <RelatedContent entry={lecture} collections={graphCollections} heading="Related & further reading" />
</ContentLayout>

<style>
  .slides-link {
    margin-block: 1.25rem 1.75rem;
  }

  .slides-link-label {
    margin: 0 0 0.4rem;
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--at-text-secondary);
  }

  .slides-link-button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 1.2rem;
    border: 2px solid var(--at-primary);
    border-radius: 999px;
    color: inherit;
    font-weight: 600;
    text-decoration: none;
  }

  .slides-link-button:hover {
    background: var(--at-primary);
    color: white;
  }
</style>
