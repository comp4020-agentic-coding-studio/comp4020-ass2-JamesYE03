---
import { getPublishedCollection } from "astro-course-university/content";
import { withBase } from "astro-theme-university/url";
import { formatCourseDate } from "../lib/dates";

const sessions = await getPublishedCollection("sessions");
const lectures = await getPublishedCollection("lectures");
const assessments = await getPublishedCollection("assessments");

const weeks = Array.from({ length: 12 }, (_, i) => {
  const week = i + 1;
  const lecture = lectures.find((l) => l.data.week === week);
  const session = sessions.find((s) => s.data.week === week);
  const due = assessments.filter((a) => a.data.week === week);
  return { week, lecture, session, due };
});
---

<div class="schedule-wrap">
  <table class="schedule-table">
    <caption>The twelve weeks, at a glance</caption>
    <thead>
      <tr>
        <th scope="col">Week</th>
        <th scope="col">Lecture</th>
        <th scope="col">Casework</th>
        <th scope="col">Due</th>
      </tr>
    </thead>
    <tbody>
      {
        weeks.map(({ week, lecture, session, due }) => (
          <tr>
            <th scope="row">{week}</th>
            <td>
              {lecture ? (
                <a href={withBase(`/lectures/${lecture.id}/`)}>{lecture.data.title}</a>
              ) : (
                <span class="schedule-empty">—</span>
              )}
            </td>
            <td>
              {session ? (
                <a href={withBase(`/sessions/${session.id}/`)}>{session.data.title}</a>
              ) : (
                <span class="schedule-empty">—</span>
              )}
            </td>
            <td>
              {due.length > 0 ? (
                due.map((assessment) => (
                  <a href={withBase(`/assessments/${assessment.id}/`)}>
                    {assessment.data.title} ({assessment.data.weight}%)
                  </a>
                ))
              ) : (
                <span class="schedule-empty">—</span>
              )}
              {due.length > 0 && (
                <div class="schedule-due-date">
                  <small>{formatCourseDate(due[0].data.due)}</small>
                </div>
              )}
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<style>
  .schedule-wrap {
    overflow-x: auto;
    margin-block: 1.5rem 2rem;
  }

  .schedule-table {
    width: 100%;
    min-width: 40rem;
    border-collapse: collapse;
    font-size: 0.95rem;
  }

  .schedule-table caption {
    text-align: start;
    font-weight: 600;
    margin-block-end: 0.5rem;
  }

  .schedule-table th,
  .schedule-table td {
    padding: 0.6rem 0.9rem;
    border-block-end: 1px solid color-mix(in srgb, currentColor 15%, transparent);
    text-align: start;
    vertical-align: top;
  }

  .schedule-table thead th {
    border-block-end: 2px solid var(--at-primary);
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .schedule-table tbody th[scope="row"] {
    font-variant-numeric: tabular-nums;
    color: var(--at-text-secondary);
  }

  .schedule-table td a {
    display: block;
  }

  .schedule-table td a + a {
    margin-block-start: 0.35rem;
  }

  .schedule-due-date {
    margin-block-start: 0.15rem;
    color: var(--at-text-secondary);
  }

  .schedule-empty {
    color: var(--at-text-secondary);
  }
</style>
